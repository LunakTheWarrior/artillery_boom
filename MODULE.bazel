module(
    name = "artillery_boom",
    version = "0.1.0",
)

bazel_dep(name = "pico-sdk", version = "2.3.1")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "picotool", version = "2.3.0")
bazel_dep(name = "platforms", version = "0.0.11")

# These legacy feature placeholders are still required by rules_cc's own
# replacement features through their `overrides` attributes.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = ["//bazel:rules_cc_deprecations.patch"],
)

# Fix host compiler warnings in picotool 2.3.0, including an uninitialized flag.
single_version_override(
    module_name = "picotool",
    patch_strip = 1,
    patches = ["//bazel:picotool_warnings.patch"],
)

# SDK 2.3.1 is not yet in the Bazel Central Registry. Pin the release archive.
# The patch selects the same Linux x86_64 compiler as the previous CI build.
archive_override(
    module_name = "pico-sdk",
    integrity = "sha256-ONMVtwkZhRNHIc07tqllbw74Ri7I3Hti1Yhrx6nSdaI=",
    patch_strip = 1,
    patches = [
        "//bazel:arm_toolchain.patch",
        # USB stdio needs the device stack, not TinyUSB's example board setup.
        "//bazel:tinyusb_device_only.patch",
        # Retain reset-interface callbacks referenced weakly by TinyUSB.
        "//bazel:usb_reset_alwayslink.patch",
    ],
    strip_prefix = "pico-sdk-2.3.1",
    urls = ["https://github.com/raspberrypi/pico-sdk/archive/refs/tags/2.3.1.tar.gz"],
)

register_toolchains("@pico-sdk//bazel/toolchain:linux-x86_64-rp2350")

# Uno SMD firmware: pinned upstream core and Linux x86_64 AVR toolchain.
bazel_dep(name = "rules_shell", version = "0.2.0")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "arduino_avr",
    urls = ["https://downloads.arduino.cc/cores/staging/avr-1.8.8.tar.bz2"],
    sha256 = "a234c2a43dcd01ce54be665806f183b8e6ec4e966d2e3e0c3358b63023d6390c",
    strip_prefix = "ArduinoCore-avr-1.8.8",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
exports_files(["cores/arduino/Arduino.h"])
filegroup(
    name = "sources",
    srcs = glob(["cores/arduino/**", "variants/standard/**", "libraries/Wire/src/**"]),
)
""",
)

http_archive(
    name = "avr_gcc",
    urls = ["https://downloads.arduino.cc/tools/avr-gcc-7.3.0-atmel3.6.1-arduino7-x86_64-pc-linux-gnu.tar.bz2"],
    sha256 = "bd8c37f6952a2130ac9ee32c53f6a660feb79bee8353c8e289eb60fdcefed91e",
    strip_prefix = "avr",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
exports_files(["bin/avr-g++"])
filegroup(name = "tools", srcs = glob(["**"]))
""",
)
